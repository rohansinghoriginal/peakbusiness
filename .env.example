# Keep local credentials in one file: copy this file to .env.local and fill its values.
# Never commit .env.local or put secret values in NEXT_PUBLIC_ variables.

# Clerk - obtain through `clerk env pull` after completing Clerk CLI login.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase - use the project root URL, not the /rest/v1 URL.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=

# Optional: enables AI-assisted sales-report header mapping.
OPENROUTER_API_KEY=

# Optional explicit URLs for production. Safe to omit during local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
